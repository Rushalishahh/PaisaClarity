# Copy this file to .env and fill in real values. NEVER commit .env.
# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserved for a future AI advisor feature (not used yet).
LLM_API_KEY=
