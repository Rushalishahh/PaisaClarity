# Copy this file to .env and fill in real values. NEVER commit .env.

# Runtime environment: "development" (default) or "production" (or set automatically if RENDER is detected).
# In production, the backend requires a reachable PostgreSQL database and a secure SECRET_KEY (min 32 characters).
ENVIRONMENT=development

# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string)
# In development, if unreachable or unset, the backend falls back to a local SQLite database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Secret key used to sign and verify JWT authentication tokens (min 32 characters in production).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

# Legacy alias for SECRET_KEY (SECRET_KEY is preferred):
# JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# Comma-separated list of frontend origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting for authentication routes (/auth/login and /auth/signup)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute

# Reverse-proxy header configuration:
# When running on Render (RENDER env var is set) or when TRUST_PROXY_HEADERS=true,
# the rate limiter inspects real client IP from Cloudflare/Render headers.
# In local development, leave TRUST_PROXY_HEADERS=false to prevent IP header spoofing.
TRUST_PROXY_HEADERS=false
PROXY_HEADER_ORDER=cf-connecting-ip,true-client-ip

# Reserved for a future AI advisor feature (not used yet).
LLM_API_KEY=
